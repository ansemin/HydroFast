db.sqlite3
backend/backup/

# Ignore specific file types in any media folder throughout the project
**/media/**/*.jpg
**/media/**/*.jpeg
**/media/**/*.png
**/media/**/*.json
**/media/**/*.stl

# Keep info.txt files in media folders
!**/media/**/info.txt

# Ignore test script outputs but not the info.txt files
backend/test/test_complete_flow/*
!backend/test/test_complete_flow/info.txt
backend/test/test_depth_no_mask/*
!backend/test/test_depth_no_mask/info.txt
backend/test/test_full_pipeline/*
!backend/test/test_full_pipeline/info.txt
backend/test/test_stl_generation/*
!backend/test/test_stl_generation/info.txt
backend/test/test image/*
!backend/test/test image/info.txt

# Don't ignore the cleanup scripts
# backend/clean_media.py
backend/apps/scans/views_original_backup.py

# Ignore logs
backend/logs

